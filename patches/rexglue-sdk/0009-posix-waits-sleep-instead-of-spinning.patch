+#include <algorithm>
 #include <rex/platform.h>
 #include <rex/thread.h>
 
@@ -367,7 +368,13 @@ class PosixConditionBase {
 
       if (!all_locked) {
         locks.clear();
-        std::this_thread::yield();
+        // Another thread holds one of the handles' mutexes (often another
+        // waiter polling the same handles). Back off with a short real sleep:
+        // a bare yield here turned two waiters into two cores of busy-spin.
+        if (std::chrono::steady_clock::now() >= end_time) {
+          return std::make_pair<WaitResult, size_t>(WaitResult::kTimeout, 0);
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
         continue;
       }
 
@@ -414,8 +421,12 @@ class PosixConditionBase {
       if (timeout == std::chrono::milliseconds::max()) {
         std::this_thread::sleep_for(std::chrono::milliseconds(1));
       } else {
-        auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(end_time - now);
-        auto sleep_time = std::min(remaining, std::chrono::milliseconds(1));
+        // Microseconds, not milliseconds: truncating the remaining time to
+        // whole milliseconds made the last sub-millisecond of every timed wait
+        // a sleep_for(0) busy-spin.
+        auto remaining = std::chrono::duration_cast<std::chrono::microseconds>(end_time - now);
+        auto sleep_time = std::clamp(remaining, std::chrono::microseconds(50),
+                                     std::chrono::microseconds(1000));
         std::this_thread::sleep_for(sleep_time);
       }
     }
